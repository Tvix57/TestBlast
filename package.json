{
  "name": "testblast",
  "version": "1.0.0",
  "private": true,
  "description": "Прототип головоломки Blast (Cocos Creator 2.4.15) + автотесты логики на Jest",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets:check": "python3 tools/validate-assets.py",
    "verify": "npm run typecheck && npm test && npm run assets:check"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
