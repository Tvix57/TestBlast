{
  "name": "testblast",
  "version": "1.0.0",
  "private": true,
  "description": "Прототип головоломки Blast (Cocos Creator 2.4.15) + автотесты логики на Jest",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:assets": "tsc -p tsconfig.assets.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "assets:check": "python3 tools/validate-assets.py",
    "build:web": "node tools/build-web.mjs",
    "pages:prepare": "node tools/prepare-pages.mjs",
    "pages:build": "npm run build:web && npm run pages:prepare",
    "pages:serve": "python3 -m http.server 8080 --directory docs",
    "verify": "npm run typecheck:assets && npm run typecheck:test && npm test && npm run assets:check"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
