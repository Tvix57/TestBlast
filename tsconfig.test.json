{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["creator.d.ts", "assets/scripts/core/**/*.ts", "assets/scripts/game/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "library", "local", "temp", "build", "settings"]
}
